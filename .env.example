# -----------------------------------------------------------------------------
# Moonlight Hostel Callback Form Configuration
# Copy this file to '.env' and fill in your keys.
# -----------------------------------------------------------------------------

# Option 1: Send submissions to a custom webhook URL (Zapier, Make, Google Sheets API, custom backend)
# VITE_FORM_WEBHOOK_URL=https://your-webhook-url.com/endpoint

# Option 2: Send submissions via Web3Forms (emails submissions directly to you for free, no backend needed)
# Get your access key at https://web3forms.com/
# VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here
