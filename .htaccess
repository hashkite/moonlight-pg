RewriteEngine On

# Redirect /index.html to /
RewriteCond %{THE_REQUEST} \s/+(index)\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect other .html URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Skip existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve clean URLs from dist/*.html
RewriteCond %{DOCUMENT_ROOT}/dist/$1.html -f
RewriteRule ^([^/]+)/?$ dist/$1.html [L]

# Serve root URL from dist/index.html
RewriteRule ^$ dist/index.html [L]

# Serve all other files from dist folder
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.*)$ dist/$1 [L]